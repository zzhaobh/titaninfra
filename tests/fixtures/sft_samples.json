    "_comment": "场景18: 长多轮对话（5轮）+ decay 策略",
    "_scenario": "long_multi_turn_decay",
    "loss_config": {"history": "decay", "history_decay": 0.5},
    "messages": [
      {"role": "user", "blocks": [{"type": "text", "text": "帮我写一个Python函数"}]},
      {"role": "assistant", "blocks": [{"type": "text", "text": "好的，请问需要什么功能？"}]},
      {"role": "user", "blocks": [{"type": "text", "text": "排序算法"}]},
      {"role": "assistant", "blocks": [{"type": "text", "text": "推荐用快速排序。要我写吗？"}]},
      {"role": "user", "blocks": [{"type": "text", "text": "好的，用Python写"}]},
      {"role": "assistant", "blocks": [{"type": "text", "text": "def quicksort(arr):\n    if len(arr) <= 1:\n        return arr\n    pivot = arr[0]\n    left = [x for x in arr[1:] if x <= pivot]\n    right = [x for x in arr[1:] if x > pivot]\n    return quicksort(left) + [pivot] + quicksort(right)"}]},
      {"role": "user", "blocks": [{"type": "text", "text": "加上类型注解"}]},
      {"role": "assistant", "blocks": [{"type": "text", "text": "def quicksort(arr: list[int]) -> list[int]:\n    if len(arr) <= 1:\n        return arr\n    pivot = arr[0]\n    left = [x for x in arr[1:] if x <= pivot]\n    right = [x for x in arr[1:] if x > pivot]\n    return quicksort(left) + [pivot] + quicksort(right)"}]},
      {"role": "user", "blocks": [{"type": "text", "text": "写个测试"}]},
      {"role": "assistant", "blocks": [{"type": "text", "text": "assert quicksort([]) == []\nassert quicksort([1]) == [1]\nassert quicksort([3,1,2]) == [1,2,3]\nassert quicksort([5,3,8,1,2]) == [1,2,3,5,8]\nprint('All tests passed!')"}]}
    ]
  },

