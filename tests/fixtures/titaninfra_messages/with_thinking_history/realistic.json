  "sample": {
    "messages": [
      {
        "role": "user",
        "blocks": [
          {
            "type": "text",
            "text": "If x + 3 = 7, what is x?"
          }
        ]
      },
      {
        "role": "assistant",
        "blocks": [
          {
            "type": "thinking",
            "text": "Subtract 3 from both sides: x = 7 - 3 = 4."
          },
          {
            "type": "text",
            "text": "x = 4."
          }
        ]
      },
      {
        "role": "user",
        "blocks": [
          {
            "type": "text",
            "text": "Now what is 2x + 1?"
          }
        ]
      },
      {
        "role": "assistant",
        "blocks": [
          {
            "type": "thinking",
            "text": "Using x = 4 from the previous step: 2*4 + 1 = 9."
          },
          {
            "type": "text",
            "text": "2x + 1 = 9."
          }
        ]
      }
    ]
  }
}
