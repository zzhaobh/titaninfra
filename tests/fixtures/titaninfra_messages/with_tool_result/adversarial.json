{
  "_scenario": "with_tool_result",
  "_variant": "adversarial",
  "_description": "Tool returns an error (is_error=true). Encoder should still wire the result through.",
  "_uses_blocks": [
    "TextBlock",
    "ToolUseBlock",
    "ToolResultBlock"
  ],
  "_uses_features": [
    "tools_declaration",
    "tool_call",
    "tool_result"
  ],
  "_expects_empty_for_families": [],
  "sample": {
    "tools": [
      {
        "name": "get_weather",
        "description": "Return current weather for a city.",
        "input_schema": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string",
              "description": "City name"
            }
          },
          "required": [
            "city"
          ]
        }
      }
    ],
    "messages": [
      {
        "role": "user",
        "blocks": [
          {
            "type": "text",
            "text": "Weather on Mars?"
          }
        ]
      },
      {
        "role": "assistant",
        "blocks": [
          {
            "type": "tool_use",
            "id": "c1",
            "name": "get_weather",
            "input": {
              "city": "Mars"
            }
          }
        ]
      },
      {
        "role": "tool",
        "blocks": [
          {
            "type": "tool_result",
            "tool_use_id": "c1",
            "text": "{\"error\": \"city not found\", \"code\": 404}",
            "is_error": true
          }
        ]
      },
      {
        "role": "assistant",
        "blocks": [
          {
            "type": "text",
            "text": "Sorry, no weather data is available for Mars."
          }
        ]
      }
    ]
  }
}
